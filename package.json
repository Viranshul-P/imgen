{
  "name": "persona-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Local amateur-phone-realism studio driving headless ComfyUI on an 8 GB GPU",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch worker/queueWorker.ts\"",
    "dev:web": "next dev",
    "worker": "tsx worker/queueWorker.ts",
    "build": "prisma generate && next build",
    "start": "concurrently -k -n web,worker -c blue,magenta \"next start\" \"tsx worker/queueWorker.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "validate:workflows": "tsx scripts/validate_workflows.ts"
  },
  "engines": {
    "node": ">=22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
