{
  "__version": 11,
  "training_method": "LORA",
  "model_type": "STABLE_DIFFUSION_XL_10_BASE",
  "base_model_name": "{{SDXL_BASE}}",
  "output_model_destination": "{{OUTPUT_DIR}}/{{TRIGGER}}_sdxl_lora.safetensors",
  "output_model_format": "SAFETENSORS",
  "concept_file_name": "{{CONCEPTS_FILE}}",
  "resolution": "1024",
  "aspect_ratio_bucketing": true,
  "latent_caching": true,
  "batch_size": 1,
  "epochs": "{{EPOCHS}}",
  "learning_rate": 0.0001,
  "learning_rate_scheduler": "CONSTANT",
  "learning_rate_warmup_steps": 100.0,
  "train_dtype": "BFLOAT_16",
  "optimizer": {
    "optimizer": "ADAFACTOR",
    "relative_step": false,
    "scale_parameter": false,
    "warmup_init": false
  },
  "lora_rank": 16,
  "lora_alpha": 16.0,
  "layer_filter_preset": "attn-mlp",
  "unet": {
    "train": true,
    "weight_dtype": "FLOAT_16",
    "gradient_checkpointing": true
  },
  "text_encoder": {
    "train": false,
    "weight_dtype": "FLOAT_16"
  },
  "text_encoder_2": {
    "train": false,
    "weight_dtype": "FLOAT_16"
  },
  "vae": {
    "weight_dtype": "FLOAT_32"
  }
}
