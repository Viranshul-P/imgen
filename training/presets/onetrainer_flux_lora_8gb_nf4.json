{
  "__version": 11,
  "training_method": "LORA",
  "model_type": "FLUX_DEV_1",
  "base_model_name": "{{FLUX_BASE}}",
  "output_model_destination": "{{OUTPUT_DIR}}/{{TRIGGER}}_flux_lora.safetensors",
  "output_model_format": "DIFFUSERS_LORA",
  "concept_file_name": "{{CONCEPTS_FILE}}",
  "resolution": "512",
  "aspect_ratio_bucketing": true,
  "latent_caching": true,
  "batch_size": 1,
  "epochs": "{{EPOCHS}}",
  "learning_rate": 0.0003,
  "learning_rate_scheduler": "CONSTANT",
  "learning_rate_warmup_steps": 100.0,
  "train_dtype": "BFLOAT_16",
  "timestep_distribution": "LOGIT_NORMAL",
  "dynamic_timestep_shifting": true,
  "optimizer": {
    "optimizer": "ADAFACTOR",
    "relative_step": false,
    "scale_parameter": false,
    "warmup_init": false
  },
  "lora_rank": 16,
  "lora_alpha": 16.0,
  "transformer": {
    "train": true,
    "weight_dtype": "NFLOAT_4",
    "gradient_checkpointing": true,
    "offload_fraction": 0.5,
    "activation_offloading": true
  },
  "text_encoder": {
    "train": false,
    "weight_dtype": "BFLOAT_16"
  },
  "text_encoder_2": {
    "train": false,
    "weight_dtype": "NFLOAT_4"
  },
  "vae": {
    "weight_dtype": "FLOAT_32"
  }
}
