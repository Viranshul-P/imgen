{
  "_pf": {
    "name": "engine_c_wardrobe_inpaint",
    "engine": "SDXL",
    "description": "Engine C - pixel-locked sequential wardrobe inpainting. Crops the masked region, samples it at native SDXL resolution with Differential Diffusion, stitches it back, then composites through the feathered mask so every pixel outside the mask is identical to the base stage image.",
    "placeholders": {
      "BASE_STAGE_IMAGE": { "type": "string", "default": "", "modelCategory": "input_image" },
      "USER_MASK_IMAGE": { "type": "string", "default": "", "modelCategory": "input_image" },
      "MASK_CHANNEL": { "type": "string", "default": "red" },
      "MASK_GROW": { "type": "int", "default": 12 },
      "MASK_BLUR_KERNEL": { "type": "int", "default": 10 },
      "MASK_BLUR_SIGMA": { "type": "float", "default": 10.0 },
      "CROP_TARGET_WIDTH": { "type": "int", "default": 1024 },
      "CROP_TARGET_HEIGHT": { "type": "int", "default": 1024 },
      "SDXL_CHECKPOINT_NAME": { "type": "string", "default": "RealVisXL_V5.0_fp16.safetensors", "modelCategory": "checkpoints" },
      "VAE_NAME": { "type": "string", "default": "sdxl_vae.safetensors", "modelCategory": "vae" },
      "POSITIVE_PROMPT": { "type": "string", "default": "" },
      "NEGATIVE_PROMPT": { "type": "string", "default": "" },
      "SEED": { "type": "int", "default": 0 },
      "STEPS": { "type": "int", "default": 28 },
      "CFG": { "type": "float", "default": 5.0 },
      "SAMPLER": { "type": "string", "default": "dpmpp_2m_sde" },
      "SCHEDULER": { "type": "string", "default": "karras" },
      "INPAINT_DENOISE": { "type": "float", "default": 0.75, "min": 0.55, "max": 0.92 },
      "FILENAME_PREFIX": { "type": "string", "default": "personaforge/engine_c" }
    },
    "features": {},
    "loraAnchors": [{ "node": "10", "mode": "model_clip" }]
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{BASE_STAGE_IMAGE}}" },
    "_meta": { "title": "Base stage image" }
  },
  "2": {
    "class_type": "LoadImageMask",
    "inputs": { "image": "{{USER_MASK_IMAGE}}", "channel": "{{MASK_CHANNEL}}" },
    "_meta": { "title": "User wardrobe mask (white = repaint)" }
  },
  "3": {
    "class_type": "GrowMask",
    "inputs": { "mask": ["2", 0], "expand": "{{MASK_GROW}}", "tapered_corners": true },
    "_meta": { "title": "Grow mask" }
  },
  "4": {
    "class_type": "ImpactGaussianBlurMask",
    "inputs": { "mask": ["3", 0], "kernel_size": "{{MASK_BLUR_KERNEL}}", "sigma": "{{MASK_BLUR_SIGMA}}" },
    "_meta": { "title": "Feather mask" }
  },
  "5": {
    "class_type": "InpaintCropImproved",
    "inputs": {
      "image": ["1", 0],
      "mask": ["4", 0],
      "downscale_algorithm": "bilinear",
      "upscale_algorithm": "bicubic",
      "preresize": false,
      "preresize_mode": "ensure minimum resolution",
      "preresize_min_width": 1024,
      "preresize_min_height": 1024,
      "preresize_max_width": 16384,
      "preresize_max_height": 16384,
      "mask_fill_holes": true,
      "mask_expand_pixels": 0,
      "mask_invert": false,
      "mask_blend_pixels": 16,
      "mask_hipass_filter": 0.1,
      "extend_for_outpainting": false,
      "extend_up_factor": 1.0,
      "extend_down_factor": 1.0,
      "extend_left_factor": 1.0,
      "extend_right_factor": 1.0,
      "context_from_mask_extend_factor": 1.6,
      "output_resize_to_target_size": true,
      "output_target_width": "{{CROP_TARGET_WIDTH}}",
      "output_target_height": "{{CROP_TARGET_HEIGHT}}",
      "output_padding": "32",
      "device_mode": "gpu (much faster)"
    },
    "_meta": { "title": "Crop masked region to native SDXL size" }
  },
  "10": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{{SDXL_CHECKPOINT_NAME}}" },
    "_meta": { "title": "SDXL checkpoint (LoRA anchor)" }
  },
  "11": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{{VAE_NAME}}" },
    "_meta": { "title": "SDXL fp16-fix VAE" }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{POSITIVE_PROMPT}}", "clip": ["10", 1] },
    "_meta": { "title": "Stage prompt" }
  },
  "13": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE_PROMPT}}", "clip": ["10", 1] },
    "_meta": { "title": "Negative" }
  },
  "14": {
    "class_type": "InpaintModelConditioning",
    "inputs": { "positive": ["12", 0], "negative": ["13", 0], "vae": ["11", 0], "pixels": ["5", 1], "mask": ["5", 2], "noise_mask": true },
    "_meta": { "title": "Inpaint conditioning" }
  },
  "15": {
    "class_type": "DifferentialDiffusion",
    "inputs": { "model": ["10", 0], "strength": 1.0 },
    "_meta": { "title": "Differential Diffusion (soft mask edges)" }
  },
  "16": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["15", 0],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "positive": ["14", 0],
      "negative": ["14", 1],
      "latent_image": ["14", 2],
      "denoise": "{{INPAINT_DENOISE}}"
    },
    "_meta": { "title": "Inpaint sample" }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["16", 0], "vae": ["11", 0] },
    "_meta": { "title": "Decode crop" }
  },
  "18": {
    "class_type": "InpaintStitchImproved",
    "inputs": { "stitcher": ["5", 0], "inpainted_image": ["17", 0] },
    "_meta": { "title": "Stitch crop back" }
  },
  "19": {
    "class_type": "ImageCompositeMasked",
    "inputs": { "destination": ["1", 0], "source": ["18", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["4", 0] },
    "_meta": { "title": "Pixel lock: original outside feathered mask" }
  },
  "20": {
    "class_type": "SaveImage",
    "inputs": { "images": ["19", 0], "filename_prefix": "{{FILENAME_PREFIX}}" },
    "_meta": { "title": "Save stage" }
  }
}
