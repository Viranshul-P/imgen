{
  "_pf": {
    "name": "genesis_dataset",
    "engine": "SDXL",
    "description": "Genesis step 2 - one varied training image (angle/lighting/framing set by the prompt) of the fictional character, identity driven by IP-Adapter FaceID Plus v2 from master_face.png. The worker queues 35 of these with different prompts and seeds.",
    "placeholders": {
      "SDXL_CHECKPOINT_NAME": { "type": "string", "default": "RealVisXL_V5.0_fp16.safetensors", "modelCategory": "checkpoints" },
      "VAE_NAME": { "type": "string", "default": "sdxl_vae.safetensors", "modelCategory": "vae" },
      "MASTER_FACE_IMAGE": { "type": "string", "default": "", "modelCategory": "input_image" },
      "POSITIVE_PROMPT": { "type": "string", "default": "" },
      "NEGATIVE_PROMPT": { "type": "string", "default": "" },
      "SEED": { "type": "int", "default": 0 },
      "STEPS": { "type": "int", "default": 28 },
      "CFG": { "type": "float", "default": 5.0 },
      "SAMPLER": { "type": "string", "default": "dpmpp_2m_sde" },
      "SCHEDULER": { "type": "string", "default": "karras" },
      "WIDTH": { "type": "int", "default": 832 },
      "HEIGHT": { "type": "int", "default": 1216 },
      "IPADAPTER_LORA_STRENGTH": { "type": "float", "default": 0.6 },
      "IPADAPTER_WEIGHT": { "type": "float", "default": 0.9 },
      "IPADAPTER_FACEIDV2_WEIGHT": { "type": "float", "default": 1.2 },
      "DETAILER_STEPS": { "type": "int", "default": 20 },
      "FACE_DENOISE": { "type": "float", "default": 0.28 },
      "FACE_DETECTOR": { "type": "string", "default": "bbox/face_yolov8m.pt", "modelCategory": "ultralytics" },
      "FILENAME_PREFIX": { "type": "string", "default": "personaforge/genesis_dataset" }
    },
    "features": {
      "faceDetailer": { "default": true, "description": "FaceDetailer pass (low denoise keeps the FaceID identity)" }
    },
    "loraAnchors": [{ "node": "1", "mode": "model_clip" }]
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{{SDXL_CHECKPOINT_NAME}}" },
    "_meta": { "title": "SDXL checkpoint (LoRA anchor)" }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{{VAE_NAME}}" },
    "_meta": { "title": "SDXL fp16-fix VAE" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{POSITIVE_PROMPT}}", "clip": ["1", 1] },
    "_meta": { "title": "Dataset frame prompt" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE_PROMPT}}", "clip": ["1", 1] },
    "_meta": { "title": "Negative" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{MASTER_FACE_IMAGE}}" },
    "_meta": { "title": "master_face.png" }
  },
  "11": {
    "class_type": "IPAdapterUnifiedLoaderFaceID",
    "inputs": { "model": ["1", 0], "preset": "FACEID PLUS V2", "lora_strength": "{{IPADAPTER_LORA_STRENGTH}}", "provider": "CUDA" },
    "_meta": { "title": "IP-Adapter FaceID Plus v2 loader" }
  },
  "12": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["11", 0],
      "ipadapter": ["11", 1],
      "image": ["10", 0],
      "weight": "{{IPADAPTER_WEIGHT}}",
      "weight_faceidv2": "{{IPADAPTER_FACEIDV2_WEIGHT}}",
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    },
    "_meta": { "title": "Apply FaceID" }
  },
  "13": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 },
    "_meta": { "title": "Latent" }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["12", 0],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["13", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "KSampler" }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["14", 0], "vae": ["2", 0] },
    "_meta": { "title": "Decode" }
  },
  "20": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": { "model_name": "{{FACE_DETECTOR}}" },
    "_meta": { "title": "Face detector", "pf": { "optional": "faceDetailer" } }
  },
  "21": {
    "class_type": "FaceDetailer",
    "inputs": {
      "image": ["15", 0],
      "model": ["12", 0],
      "clip": ["1", 1],
      "vae": ["2", 0],
      "guide_size": 512,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": "{{SEED}}",
      "steps": "{{DETAILER_STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "positive": ["3", 0],
      "negative": ["4", 0],
      "denoise": "{{FACE_DENOISE}}",
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "bbox_detector": ["20", 0],
      "wildcard": "",
      "cycle": 1
    },
    "_meta": { "title": "FaceDetailer (FaceID model)", "pf": { "optional": "faceDetailer", "bypass": { "0": "image" } } }
  },
  "30": {
    "class_type": "SaveImage",
    "inputs": { "images": ["21", 0], "filename_prefix": "{{FILENAME_PREFIX}}" },
    "_meta": { "title": "Save dataset frame" }
  }
}
