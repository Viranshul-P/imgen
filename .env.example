# Copy to .env.local (Phase 0 writes it automatically). Never commit .env.local.

# --- ComfyUI (headless, driven over HTTP/WebSocket) ---
COMFY_ROOT=C:\path\to\ComfyUI_windows_portable
COMFY_PYTHON=C:\path\to\ComfyUI_windows_portable\python_embeded\python.exe
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
COMFY_URL=http://127.0.0.1:8188
# Remote Cloud GPU Tunnel (header switcher): the local end of `ssh -N -L 8189:127.0.0.1:8188 -L 8190:127.0.0.1:8190 user@cloud-ip`.
# Remote mode turns the 8 GB limits off. See docs/CLOUD.md and scripts/vultr_cloud_setup.sh.
COMFY_REMOTE_URL=http://127.0.0.1:8189
# Cloud model fetcher (scripts/cloud_model_fetcher.py) for the Download Model dialog in Remote mode:
# add  -L 8190:127.0.0.1:8190  to the same ssh tunnel command.
COMFY_REMOTE_FETCHER_URL=http://127.0.0.1:8190
# Default 8GB-safe flags (spec section 1). ComfyUI >=0.4 removed --normalvram (normal VRAM is now the
# default when no VRAM-mode flag is given). Fallback ladder: add --lowvram.
COMFY_FLAGS=--reserve-vram 0.8 --disable-auto-launch

# Pause after POST /free before dispatching a graph on another engine/checkpoint (ms)
VRAM_FLUSH_PAUSE_MS=1500

# --- Studio ---
DATABASE_URL=file:./dev.db
DATA_DIR=./data

# --- Optional free tokens (raise rate limits / allow Civitai direct downloads) ---
HF_TOKEN=
CIVITAI_TOKEN=
